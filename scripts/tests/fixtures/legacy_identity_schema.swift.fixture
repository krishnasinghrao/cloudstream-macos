        let output: [String: Any] = ["itemID": items.first?.id ?? "", "note": items.first?.userNote ?? "", "episodeOwner": episodes.first?.itemID ?? "", "speed": prefs.first?.speed ?? 0, "downloads": downloads.count]
        print(String(decoding: try JSONSerialization.data(withJSONObject: output), as: UTF8.self))
